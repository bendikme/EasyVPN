<Window x:Class="EasyVPN.GatewayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EasyVPN"
        xmlns:gw="clr-namespace:EasyVPN.GatewayApp"
        xmlns:easy="clr-namespace:EasyVPN;assembly=EasyVPN.Shared"
        Title="EasyVPN Gateway"
        Style="{StaticResource AppWindowStyle}"
        Icon="pack://application:,,,/Assets/easyvpn.ico"
        Width="1060"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <!-- As the EasyVPN app on the workstations: no Windows title bar; the strip at the top is the
         caption, with the window buttons at its right edge (Themes\Chrome.xaml). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <app:VisibilityConverter x:Key="Visible" />
        <GridLength x:Key="LogTimeWidth">64</GridLength>

        <!-- Rows: titles are no rows, and a group's row is its own button; a facility's Edit and
             Connect show under the mouse, or chosen. -->
        <Style x:Key="FacilityContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItemStyle}">
            <Setter Property="Padding" Value="10,7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RowEditButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <DataTemplate DataType="{x:Type gw:ListSection}">
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="12,16,12,4" Text="{Binding Title}" />
        </DataTemplate>

        <!-- A customer's group: the workstations' list's group row (EasyVPN\Rows.xaml). -->
        <DataTemplate DataType="{x:Type gw:FacilityGroup}">
            <Button Style="{StaticResource GroupRowButtonStyle}"
                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Margin="8,0,4,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="{Binding Count}" />
                    <TextBlock DockPanel.Dock="Right"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource WarningBrush}"
                               Text="{Binding NotReadyText}"
                               Visibility="{Binding NotReadyText, Converter={StaticResource Visible}}" />
                    <Path x:Name="Chevron"
                          Width="10"
                          Height="10"
                          Margin="0,0,7,0"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Data="{StaticResource GeoChevron}"
                          Stroke="{DynamicResource TextMutedBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                               Text="{Binding Name}" />
                </DockPanel>
            </Button>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOpen}" Value="True">
                    <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type gw:FacilityRow}">
            <Grid x:Name="Row">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Margin="10,0,0,0" Orientation="Horizontal" Visibility="{Binding StateText, Converter={StaticResource Visible}}">
                            <Ellipse Margin="0,0,6,0" Style="{StaticResource StatusDotStyle}" Tag="{Binding State}" />
                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StateText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Margin="0,2,0,0" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Details}" />
                    <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                               Text="{Binding Doing}" Visibility="{Binding Doing, Converter={StaticResource Visible}}" />
                    <TextBlock Margin="0,4,0,0" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                               Text="{Binding Attention}" Visibility="{Binding Attention, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditButton"
                            Style="{StaticResource RowEditButtonStyle}"
                            Content="Edit"
                            ToolTip="Opens it in the facility editor, as administrator"
                            Visibility="Collapsed"
                            Command="{Binding DataContext.EditFacilitiesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button x:Name="ConnectButton"
                            Margin="6,0,0,0"
                            Style="{StaticResource RowActionButtonStyle}"
                            Content="Connect"
                            ToolTip="Connects it from here, as a workstation would: whatever is connected now is disconnected first"
                            Visibility="Collapsed"
                            Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    <Button Margin="6,0,0,0"
                            Style="{StaticResource RowDangerButtonStyle}"
                            Content="Disconnect"
                            ToolTip="Disconnects it for every workstation"
                            Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding IsCarried, Converter={StaticResource Visible}}" />
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="Disconnecting…"
                               ToolTip="Its VPN client is being disconnected; that can take a minute"
                               Visibility="{Binding IsLeaving, Converter={StaticResource Visible}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <!-- Its name under its group's, past the chevron. -->
                <DataTrigger Binding="{Binding InGroup}" Value="True">
                    <Setter TargetName="Row" Property="Margin" Value="13,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ConnectButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                    <Setter TargetName="ConnectButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Carried, or on its way down: nothing to connect. -->
                <DataTrigger Binding="{Binding IsFree}" Value="False">
                    <Setter TargetName="ConnectButton" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- In place of the list: a title, a sentence, and the one thing to do about it. -->
        <Style x:Key="EmptyTitleStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="EmptyTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleStripHeight}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ title strip: brand, search, toolbar, window buttons -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100*" MaxWidth="420" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource BrandMarkTemplate}" Focusable="False" />
                    <TextBlock Text="EasyVPN Gateway"
                               Margin="9,0,0,0"
                               FontSize="{StaticResource FontSizeMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Column="1" Margin="24,0,16,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource AppTextBoxStyle}"
                             Padding="32,5,30,5"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search the facilities by name, customer, VPN client, network or notes (Ctrl+F)" />
                    <Viewbox Width="14" Height="14" Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False">
                        <Path Style="{StaticResource IconFrameStyle}" Data="{StaticResource GeoSearch}" StrokeThickness="1.7" StrokeEndLineCap="Round" Stroke="{DynamicResource TextMutedBrush}" />
                    </Viewbox>
                    <TextBlock Text="Search facilities"
                               Margin="34,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                    <Button Width="22" Height="22" MinHeight="0" Margin="0,0,4,0" Padding="0"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnClearSearchClick"
                            ToolTip="Clear the search"
                            Visibility="{Binding SearchText, Converter={StaticResource Visible}}">
                        <Viewbox Width="10" Height="10">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoClose}" />
                        </Viewbox>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="3" Margin="0,0,8,0" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding EditFacilitiesCommand}"
                            ToolTip="Opens the facility editor, as administrator. The gateway uses what is saved there straight away.">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoEdit}" />
                            </Viewbox>
                            <TextBlock Text="Facilities" />
                        </StackPanel>
                    </Button>

                    <!-- What a workstation needs, once: a flyout, not a column. -->
                    <ToggleButton x:Name="WorkstationsToggle" Margin="4,0,0,0" ToolTip="The gateway's address, access key and certificate, for setting up a workstation">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolbarToggleButtonStyle}">
                                <Style.Triggers>
                                    <!-- A click on the button while open only closes it. -->
                                    <DataTrigger Binding="{Binding IsOpen, ElementName=WorkstationsPopup}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Data="{StaticResource GeoWorkstation}" />
                            </Viewbox>
                            <TextBlock Text="Workstations" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="WorkstationsPopup"
                           IsOpen="{Binding IsChecked, ElementName=WorkstationsToggle, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=WorkstationsToggle}"
                           Placement="Custom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="None">
                        <Border Style="{StaticResource FlyoutBorderStyle}" Width="400">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Gateway address" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Content="Copy"
                                            Command="{Binding CopyCommand}" CommandParameter="{Binding GatewayAddress}" />
                                    <TextBlock Style="{StaticResource MonoTextStyle}" Text="{Binding GatewayAddress}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding OtherAddresses}" Visibility="{Binding OtherAddresses, Converter={StaticResource Visible}}" />

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Access key" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Content="Show…"
                                            ToolTip="Asks for administrator rights: whoever has the key can use the gateway"
                                            Command="{Binding ShowAccessKeyCommand}" />
                                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Text="Kept on the gateway, for administrators" />
                                </DockPanel>

                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Certificate fingerprint" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}" Content="Copy"
                                            Command="{Binding CopyCommand}" CommandParameter="{Binding Thumbprint}" />
                                    <TextBlock Style="{StaticResource MonoTextStyle}" FontSize="{StaticResource FontSizeSmall}" Text="{Binding Thumbprint}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,10,0,0"
                                           Text="A workstation is given the address and key once, in EasyVPN's Settings, and pins this certificate the first time it connects." />

                                <Border Style="{StaticResource AppSeparatorStyle}" Margin="0,14,0,0" />
                                <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,4" Text="THIS GATEWAY" />
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="Checking…" Visibility="{Binding SystemChecks, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                                <ItemsControl ItemsSource="{Binding SystemChecks}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <Ellipse DockPanel.Dock="Left" Margin="0,5,10,0" VerticalAlignment="Top" Style="{StaticResource StatusDotStyle}" Tag="{Binding Level}" />
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" />
                                                    <TextBlock Margin="0,1,0,0" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Text}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Button Margin="4,0,0,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CheckCommand}"
                            ToolTip="Checks every facility's VPN client, and what the gateway needs, again">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoRefresh}" />
                            </Viewbox>
                            <TextBlock Text="{Binding RefreshText}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="4,0,0,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SettingsCommand}"
                            ToolTip="What the facilities of a kind share, such as Tosi Client's program and password. Asks for administrator rights.">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoGear}" />
                            </Viewbox>
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimise" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionMaximizeButtonStyle}" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;" ToolTip="Close to the notification area" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ banners: what is wrong now, and its fix -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource BannerStyle}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
                <TextBlock TextWrapping="Wrap" Text="{Binding Error}" />
            </Border>
            <ItemsControl ItemsSource="{Binding FacilityProblems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BannerStyle}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding SystemProblems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource BannerStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Level}" Value="{x:Static easy:CheckLevel.Warning}">
                                            <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Content="{Binding FixText}"
                                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding FixText, Converter={StaticResource Visible}}" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="{Binding Subject, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ============================================================ the facilities: the one carried first, then by customer -->
        <Grid Grid.Row="2">
            <ListBox x:Name="FacilityList"
                     Margin="12,0,12,8"
                     Style="{StaticResource AppListBoxStyle}"
                     ItemContainerStyle="{StaticResource FacilityContainerStyle}"
                     ItemsSource="{Binding Rows}" />

            <StackPanel MaxWidth="440" Margin="24" VerticalAlignment="Center" Visibility="{Binding ServiceOnline, Converter={StaticResource Visible}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource EmptyTitleStyle}" Text="The EasyVPN Gateway service is not running" />
                <TextBlock Style="{StaticResource EmptyTextStyle}" Text="It connects the facilities and carries the workstations' tunnels. Windows starts it by itself; start it here if it was stopped." />
                <Button HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Content="Start the service" ToolTip="Asks for administrator rights" Command="{Binding StartServiceCommand}" />
            </StackPanel>

            <StackPanel MaxWidth="440" Margin="24" VerticalAlignment="Center" Visibility="{Binding HasNoFacilities, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource EmptyTitleStyle}" Text="No facilities yet" />
                <TextBlock Style="{StaticResource EmptyTextStyle}" Text="Add the first one in the facility editor, or import a list of them there." />
                <Button HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Content="Edit facilities" Command="{Binding EditFacilitiesCommand}" />
            </StackPanel>

            <TextBlock Margin="24" VerticalAlignment="Center" Style="{StaticResource EmptyTextStyle}" Text="Nothing matches the search."
                       Visibility="{Binding NoMatches, Converter={StaticResource Visible}}" />
        </Grid>

        <!-- ============================================================ activity: a log, oldest first, which folds away -->
        <StackPanel Grid.Row="3">
            <Border Style="{StaticResource PanelHeaderStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource StatusLinkButtonStyle}" Content="Copy" ToolTip="Copies the lines selected, or all of them" Click="OnCopyActivityClick"
                                Visibility="{Binding IsChecked, ElementName=ActivityToggle, Converter={StaticResource Visible}}" />
                        <ToggleButton x:Name="ActivityToggle" Margin="4,0,0,0" Style="{StaticResource ChevronToggleStyle}" IsChecked="True" ToolTip="Shows or hides the activity" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" Text="ACTIVITY" />
                </DockPanel>
            </Border>
            <Grid Height="170" Visibility="{Binding IsChecked, ElementName=ActivityToggle, Converter={StaticResource Visible}}">
                <TextBlock Margin="24,4" Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" Text="Nothing yet."
                           Visibility="{Binding Activity, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                <ListBox x:Name="ActivityList"
                         Margin="18,0,12,8"
                         Style="{StaticResource AppListBoxStyle}"
                         ItemsSource="{Binding Activity}"
                         SelectionMode="Extended"
                         FontSize="{StaticResource FontSizeSmall}">
                    <ListBox.CommandBindings>
                        <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyActivity" />
                    </ListBox.CommandBindings>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItemStyle}">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="VerticalContentAlignment" Value="Top" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource LogTimeWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                           Text="{Binding Time.LocalDateTime, StringFormat=HH:mm:ss}"
                                           ToolTip="{Binding Time.LocalDateTime, StringFormat=dddd d MMMM yyyy HH:mm:ss}" />
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Text}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </StackPanel>

        <!-- ============================================================ status strip: the connection, the service; updates -->
        <Border Grid.Row="4" Style="{StaticResource StatusStripStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" Style="{StaticResource StatusTextStyle}" Text="{Binding UpdateNote}" Visibility="{Binding UpdateNote, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource StatusLinkButtonStyle}" Content="{Binding UpdateButtonText}" IsEnabled="{Binding CanUpdate}" Click="OnUpdateClick" />
                    <TextBlock Style="{StaticResource StatusSeparatorStyle}" Margin="4,0,10,0" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding VersionText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Margin="0,0,7,0" Style="{StaticResource StatusDotStyle}" Tag="{Binding State}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ConnectionText}" />
                    <TextBlock Style="{StaticResource StatusSeparatorStyle}" />
                    <Ellipse Margin="0,0,7,0" Style="{StaticResource StatusDotStyle}" Tag="{Binding ServiceLevel}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding ServiceText}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
