<Window x:Class="EasyVPN.GatewayApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EasyVPN"
        xmlns:easy="clr-namespace:EasyVPN;assembly=EasyVPN.Shared"
        Title="EasyVPN Gateway"
        Style="{StaticResource AppWindowStyle}"
        Icon="pack://application:,,,/Assets/easyvpn.ico"
        Width="1060"
        Height="760"
        MinWidth="780"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <!-- As the EasyVPN app on the workstations: no Windows title bar; the strip at the top is the
         caption, with the window buttons at its right edge (Themes\Chrome.xaml). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <app:VisibilityConverter x:Key="Visible" />
        <GridLength x:Key="LogTimeWidth">64</GridLength>

        <!-- Whether something is ready, as a coloured dot. Put the CheckLevel in Tag. -->
        <Style x:Key="CheckDotStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,5,12,0" />
            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static easy:CheckLevel.Ok}">
                    <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static easy:CheckLevel.Warning}">
                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static easy:CheckLevel.Problem}">
                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style x:Key="CodeStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ title strip: brand, toolbar, window buttons -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource BrandMarkTemplate}" Focusable="False" />
                    <TextBlock Text="EasyVPN Gateway"
                               Margin="9,0,0,0"
                               FontSize="{StaticResource FontSizeMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="14,0,12,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Connects the facility VPNs on this machine, for every EasyVPN workstation" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding CheckCommand}"
                            ToolTip="Checks every facility's VPN client, and what the gateway needs, again">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoRefresh}" />
                            </Viewbox>
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Margin="4,0,8,0"
                            Command="{Binding SettingsCommand}"
                            ToolTip="What the facilities of a kind share, such as Tosi Client's program and password. Asks for administrator rights.">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoGear}" />
                            </Viewbox>
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimise" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionMaximizeButtonStyle}" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;" ToolTip="Close to the notification area" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource AppScrollViewerStyle}">
            <Grid Margin="24,20,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- ============================================================ facilities, the one carried among them -->
                <StackPanel>
                    <TextBlock Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding Error}"
                               Visibility="{Binding Error, Converter={StaticResource Visible}}" />

                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ChecksText}" />
                            <Button Style="{StaticResource SubtleButtonStyle}"
                                    Content="Encrypt a password…"
                                    ToolTip="Encrypts a VPN password for writing facilities.json by hand. The facility editor does it by itself."
                                    Click="OnEncryptPasswordClick" />
                            <Button Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Content="Edit facilities…"
                                    ToolTip="Opens the facility editor, as administrator. The gateway uses what is saved there straight away."
                                    Command="{Binding EditFacilitiesCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" Text="FACILITIES" />
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding FacilityProblems}" Visibility="{Binding FacilityProblems, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,14" Visibility="{Binding Facilities, Converter={StaticResource Visible}, ConverterParameter=invert}">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Text="No facilities yet. Choose Edit facilities to add the first one." />
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="0" Visibility="{Binding Facilities, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding Facilities}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,12" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <!-- The one carried: Disconnect. Any other: Connect, which takes it over. -->
                                            <Grid DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top">
                                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                                        MinWidth="96"
                                                        Content="Connect"
                                                        ToolTip="Connects it from here, as a workstation would: whatever is connected now is disconnected first"
                                                        Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsCarried, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                                                <Button Style="{StaticResource DangerButtonStyle}"
                                                        MinWidth="96"
                                                        Content="Disconnect"
                                                        Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Visibility="{Binding IsCarried, Converter={StaticResource Visible}}" />
                                            </Grid>
                                            <Button DockPanel.Dock="Right"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Top"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Content="Edit"
                                                    ToolTip="Opens it in the facility editor, as administrator"
                                                    Command="{Binding DataContext.EditFacilitiesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource CheckDotStyle}" Tag="{Binding Level}" ToolTip="{Binding ReadinessText}" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource StatusPillStyle}" Margin="10,0,0,0" Visibility="{Binding State, Converter={StaticResource Visible}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" Style="{StaticResource StateDotStyle}" Tag="{Binding State}" />
                                                            <TextBlock Text="{Binding State}" FontSize="{StaticResource FontSizeSmall}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource HintStyle}" Text="{Binding Details}" />
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Text="{Binding Attention}" Visibility="{Binding Attention, Converter={StaticResource Visible}}" />
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Message}" Visibility="{Binding Message, Converter={StaticResource Visible}}" />
                                                <TextBlock Style="{StaticResource HintStyle}" Text="{Binding AskedBy}" Visibility="{Binding AskedBy, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- ============================================================ for workstations, the gateway, activity -->
                <StackPanel Grid.Column="2">
                    <!-- Level with the facilities, whose heading shares its line with buttons. -->
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,15" Text="FOR WORKSTATIONS" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,4,16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Gateway address" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButtonStyle}" Content="Copy"
                                        Command="{Binding CopyCommand}" CommandParameter="{Binding GatewayAddress}" />
                                <TextBlock Style="{StaticResource CodeStyle}" Text="{Binding GatewayAddress}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="{Binding OtherAddresses}" Visibility="{Binding OtherAddresses, Converter={StaticResource Visible}}" />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Access key" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Content="Show the access key…" Command="{Binding ShowAccessKeyCommand}" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="Asks for administrator rights: whoever has the key can use the gateway." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Certificate fingerprint" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource SubtleButtonStyle}" Content="Copy"
                                        Command="{Binding CopyCommand}" CommandParameter="{Binding Thumbprint}" />
                                <TextBlock Style="{StaticResource CodeStyle}" FontSize="{StaticResource FontSizeSmall}" Text="{Binding Thumbprint}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource HintStyle}" Text="Each workstation pins it the first time it connects. EasyVPN's Settings there should show the same." />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,22,0,6" Text="THIS GATEWAY" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,12">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="Checking…" Visibility="{Binding SystemChecks, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding SystemChecks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2,0,8">
                                            <Ellipse DockPanel.Dock="Left" Style="{StaticResource CheckDotStyle}" Tag="{Binding Level}" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" />
                                                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Text}" />
                                                <Button Margin="0,8,0,0"
                                                        HorizontalAlignment="Left"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="{Binding FixText}"
                                                        Command="{Binding DataContext.FixCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding FixText, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ============================================================ activity: a log, oldest first, kept to its own height -->
        <Border Grid.Row="2"
                Height="200"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <DockPanel Margin="24,10,24,12">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding ActivityText}" />
                        <Button Style="{StaticResource SubtleButtonStyle}" Content="Copy" ToolTip="Copies the lines selected, or all of them" Click="OnCopyActivityClick" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" Text="ACTIVITY" />
                </DockPanel>

                <Grid>
                    <TextBlock Margin="0,4" Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" Text="Nothing yet."
                               Visibility="{Binding Activity, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                    <ListBox x:Name="ActivityList"
                             Style="{StaticResource AppListBoxStyle}"
                             ItemsSource="{Binding Activity}"
                             SelectionMode="Extended"
                             FontSize="{StaticResource FontSizeSmall}">
                        <ListBox.CommandBindings>
                            <CommandBinding Command="ApplicationCommands.Copy" Executed="OnCopyActivity" />
                        </ListBox.CommandBindings>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItemStyle}">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="6,1" />
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource LogTimeWidth}" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding Time.LocalDateTime, StringFormat=HH:mm:ss}"
                                               ToolTip="{Binding Time.LocalDateTime, StringFormat=dddd d MMMM yyyy HH:mm:ss}" />
                                    <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Text}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ============================================================ status strip: the service, what needs attention, updates -->
        <Border Grid.Row="3"
                Padding="14,5"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource StatusTextStyle}" Text="{Binding VersionText}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding Update, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding UpdateText}" />
                    <Button Margin="8,0,0,0"
                            Padding="6,1"
                            MinHeight="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Content="{Binding UpdateButtonText}"
                            IsEnabled="{Binding CanUpdate}"
                            Click="OnUpdateClick" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding ProblemText, Converter={StaticResource Visible}}">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource WarningBrush}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding ProblemText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Style="{StaticResource StateDotStyle}" Tag="{Binding State}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ConnectionText}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Margin="12,0" Text="·" />
                    <Ellipse x:Name="ServiceDot" Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource SuccessBrush}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding ServiceText}" />
                    <Button Margin="10,0,0,0"
                            Padding="6,1"
                            MinHeight="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Content="Start the service"
                            ToolTip="Asks for administrator rights"
                            Command="{Binding StartServiceCommand}"
                            Visibility="{Binding ServiceOnline, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Margin="12,0" Text="·" />
                    <TextBlock Style="{StaticResource StatusTextStyle}"
                               Text="{Binding PortsText}"
                               ToolTip="The TCP ports workstations reach this gateway on: its API, and the relay their tunnel runs through" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
