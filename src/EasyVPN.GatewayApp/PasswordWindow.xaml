<Window x:Class="EasyVPN.GatewayApp.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encrypt a VPN password"
        Style="{StaticResource AppWindowStyle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="Encrypt a VPN password" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" />
        <TextBlock Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="For a facility's &quot;password&quot; in facilities.json. Only this machine can decrypt it." />

        <TextBlock Style="{StaticResource LabelStyle}" Text="Password" />
        <PasswordBox x:Name="FirstBox" Style="{StaticResource AppPasswordBoxStyle}" PasswordChanged="OnPasswordChanged" />
        <TextBlock Style="{StaticResource LabelStyle}" Text="Again" />
        <PasswordBox x:Name="SecondBox" Style="{StaticResource AppPasswordBoxStyle}" PasswordChanged="OnPasswordChanged" />

        <TextBlock Style="{StaticResource LabelStyle}" Text="Encrypted, to paste as the facility's password" />
        <TextBox x:Name="ResultBox"
                 Style="{StaticResource AppTextBoxStyle}"
                 FontFamily="Consolas"
                 TextWrapping="Wrap"
                 IsReadOnly="True" />
        <TextBlock x:Name="HintText"
                   Margin="0,6,0,0"
                   TextWrapping="Wrap"
                   FontSize="{StaticResource FontSizeSmall}"
                   Foreground="{DynamicResource TextMutedBrush}" />

        <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CopyButton" Style="{StaticResource PrimaryButtonStyle}" Content="Copy" IsEnabled="False" Click="OnCopyClick" />
            <Button Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" Content="Close" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
