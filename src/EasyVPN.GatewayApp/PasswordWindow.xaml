<Window x:Class="EasyVPN.GatewayApp.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encrypt a VPN password"
        Style="{StaticResource DialogWindowStyle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <StackPanel Margin="24,18,24,22">
            <TextBlock TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="For a facility's &quot;password&quot; written by hand in facilities.json - the facility editor encrypts by itself. Only this machine can decrypt it." />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
            <PasswordBox x:Name="FirstBox" Style="{StaticResource AppPasswordBoxStyle}" PasswordChanged="OnPasswordChanged" />
            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Again" />
            <PasswordBox x:Name="SecondBox" Style="{StaticResource AppPasswordBoxStyle}" PasswordChanged="OnPasswordChanged" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Encrypted, to paste as the facility's password" />
            <TextBox x:Name="ResultBox"
                     Style="{StaticResource AppTextBoxStyle}"
                     FontFamily="Consolas"
                     TextWrapping="Wrap"
                     IsReadOnly="True" />
            <TextBlock x:Name="HintText" Style="{StaticResource HintTextStyle}" Margin="0,6,0,0" />
        </StackPanel>

        <Border Style="{StaticResource DialogFooterStyle}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Close" IsCancel="True" />
                <Button x:Name="CopyButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="Copy" IsEnabled="False" Click="OnCopyClick" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
