<Window x:Class="EasyVPN.GatewayApp.FacilitiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EasyVPN"
        Title="EasyVPN Gateway facilities"
        Style="{StaticResource AppWindowStyle}"
        Icon="pack://application:,,,/Assets/easyvpn.ico"
        Width="1120"
        Height="820"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <app:VisibilityConverter x:Key="Visible" />

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
        <Style x:Key="FieldStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}" />
        <Style x:Key="LinesStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="MinHeight" Value="66" />
        </Style>
        <Style x:Key="SectionStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="Margin" Value="0,22,0,6" />
        </Style>

        <!-- Choices laid out as a grid of buttons, with no scrolling of their own inside the form's. -->
        <Style x:Key="ChoiceListStyle" TargetType="ListBox" BasedOn="{StaticResource AppListBoxStyle}">
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItemStyle}">
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="Padding" Value="10,4,12,4" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ header -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,14">
                <Button DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="Open facilities.json"
                        ToolTip="{Binding FilePath}"
                        Command="{Binding OpenFileCommand}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Facilities" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0" Foreground="{DynamicResource TextMutedBrush}" Text="What this gateway can connect, one at a time. The gateway uses what you save here straight away." />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ the list -->
            <Border BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,16,12,16">
                    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
                        <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding CountText}" />
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" Text="FACILITIES" />
                    </DockPanel>
                    <TextBox DockPanel.Dock="Top"
                             Margin="4,0,4,10"
                             Style="{StaticResource FieldStyle}"
                             ToolTip="Find by name, customer or id"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel DockPanel.Dock="Bottom" Margin="4,10,4,0" Orientation="Horizontal">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Add" Command="{Binding AddCommand}" ToolTip="A new facility, for the same customer as the one selected" />
                        <Button Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Content="Duplicate" Command="{Binding DuplicateCommand}" ToolTip="A copy of the one selected, password and all: quicker for another site set up the same way" />
                        <Button Margin="8,0,0,0" Style="{StaticResource SubtleButtonStyle}" Content="Remove" Command="{Binding RemoveCommand}" ToolTip="Gone when you save" />
                    </StackPanel>
                    <ListBox Style="{StaticResource AppListBoxStyle}" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right"
                                             Width="8"
                                             Height="8"
                                             Margin="8,0,0,0"
                                             Fill="{DynamicResource DangerBrush}"
                                             ToolTip="{Binding ProblemText}"
                                             Visibility="{Binding HasProblem, Converter={StaticResource Visible}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ============================================================ the facility -->
            <TextBlock Grid.Column="1"
                       Margin="24"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMutedBrush}"
                       Text="Choose a facility, or add one."
                       Visibility="{Binding Selected, Converter={StaticResource Visible}, ConverterParameter=invert}" />

            <ScrollViewer Grid.Column="1"
                          Style="{StaticResource AppScrollViewerStyle}"
                          Visibility="{Binding Selected, Converter={StaticResource Visible}}">
                <StackPanel Margin="24,16,24,24" MaxWidth="760" HorizontalAlignment="Left" DataContext="{Binding Selected}">

                    <Border Padding="14,10"
                            Background="{DynamicResource DangerSubtleBrush}"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Visibility="{Binding ProblemText, Converter={StaticResource Visible}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding ProblemText}" />
                    </Border>

                    <!-- ======================================== what it is -->
                    <TextBlock Style="{StaticResource SectionStyle}" Text="FACILITY" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,0,16,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Name" />
                                    <TextBox Style="{StaticResource FieldStyle}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="Customer" />
                                    <TextBox Style="{StaticResource FieldStyle}" Text="{Binding Customer, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Id" />
                            <TextBox Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="Letters, digits, '.', '-' and '_'. A new facility's follows its customer and name until you type one." />
                        </StackPanel>
                    </Border>

                    <!-- ======================================== how the gateway connects it -->
                    <TextBlock Style="{StaticResource SectionStyle}" Text="VPN CLIENT" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,12,16,14">
                        <StackPanel>
                            <ListBox Style="{StaticResource ChoiceListStyle}"
                                     ItemsSource="{Binding DataContext.Kinds, RelativeSource={RelativeSource AncestorType=Window}}"
                                     SelectedItem="{Binding Kind}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItemStyle}">
                                        <Setter Property="Margin" Value="0,0,6,6" />
                                        <Setter Property="Padding" Value="10,4,12,4" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding Kind.Description}" />

                            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource LabelStyle}" Text="{Binding Field.Label}" Visibility="{Binding IsFlag, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                                            <DockPanel Visibility="{Binding IsText, Converter={StaticResource Visible}}">
                                                <Button DockPanel.Dock="Right"
                                                        Margin="8,0,0,0"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Content="Browse…"
                                                        Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsFile, Converter={StaticResource Visible}}" />
                                                <TextBox Style="{StaticResource FieldStyle}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                            </DockPanel>
                                            <CheckBox Margin="0,14,0,0"
                                                      Style="{StaticResource AppCheckBoxStyle}"
                                                      Content="{Binding Field.Label}"
                                                      IsChecked="{Binding IsChecked}"
                                                      Visibility="{Binding IsFlag, Converter={StaticResource Visible}}" />
                                            <ListBox Style="{StaticResource ChoiceListStyle}"
                                                     ItemsSource="{Binding Field.Choices}"
                                                     SelectedItem="{Binding Choice}"
                                                     Visibility="{Binding IsChoice, Converter={StaticResource Visible}}" />
                                            <TextBlock Style="{StaticResource HintStyle}" Text="{Binding Field.Hint}" Visibility="{Binding Field.Hint, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding Kind.IsCustom, Converter={StaticResource Visible}}">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Settings" />
                                <TextBox Style="{StaticResource LinesStyle}" FontFamily="Consolas" Text="{Binding SettingsText}" />
                                <TextBlock Style="{StaticResource HintStyle}" Text="One per line, as key = value. The script gets each one as EASYVPN_KEY." />
                            </StackPanel>

                            <StackPanel Visibility="{Binding Kind.UsesPassword, Converter={StaticResource Visible}}">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Password" />
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource AppPasswordBoxStyle}" PasswordChanged="OnPasswordChanged" />
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Content="Remove it"
                                            Click="OnRemovePasswordClick"
                                            Visibility="{Binding CanRemovePassword, Converter={StaticResource Visible}}" />
                                    <TextBlock Style="{StaticResource HintStyle}" Margin="0" VerticalAlignment="Center" Text="{Binding PasswordText}" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ======================================== what it reaches -->
                    <TextBlock Style="{StaticResource SectionStyle}" Text="NETWORK" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,14">
                        <StackPanel>
                            <CheckBox Style="{StaticResource AppCheckBoxStyle}"
                                      Content="Layer 2: the VPN gives this gateway the facility's Ethernet, as TOSIBOX Key in Layer 2 mode does"
                                      IsChecked="{Binding Layer2}" />
                            <TextBlock Style="{StaticResource HintStyle}" Margin="24,2,0,0" Text="Workstations then get the facility's LAN on their EasyVPN L2 adapter, so routes and DNS are not used." Visibility="{Binding Layer2, Converter={StaticResource Visible}}" />

                            <StackPanel Visibility="{Binding Layer2, Converter={StaticResource Visible}, ConverterParameter=invert}">
                                <TextBlock Style="{StaticResource LabelStyle}" Text="Networks" />
                                <TextBox Style="{StaticResource LinesStyle}" FontFamily="Consolas" Text="{Binding Routes, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource HintStyle}" Text="The facility's networks, one per line, such as 10.60.0.0/24. Workstations send these, and only these, to the gateway." />
                            </StackPanel>

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Check" />
                            <TextBox Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="{Binding Check, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="host:port inside the facility that answers once it is connected: a PLC's 102, an HMI's 443. Without one, the gateway takes the VPN client at its word." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Timeout, in seconds" />
                            <TextBox Width="120" HorizontalAlignment="Left" Style="{StaticResource FieldStyle}" Text="{Binding Timeout, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="How long to wait for the check once the VPN client has run: give one connected by hand time to sign in, such as 300." />

                            <Grid Visibility="{Binding Layer2, Converter={StaticResource Visible}, ConverterParameter=invert}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="DNS names" />
                                    <TextBox Style="{StaticResource FieldStyle}" Text="{Binding DnsDomains, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="Such as plant.acme.local. Optional." />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource LabelStyle}" Text="DNS servers" />
                                    <TextBox Style="{StaticResource FieldStyle}" FontFamily="Consolas" Text="{Binding DnsServers, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource HintStyle}" Text="Inside the facility; they answer for those names while it is connected." />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ======================================== for the engineers -->
                    <TextBlock Style="{StaticResource SectionStyle}" Text="FOR WHOEVER CONNECTS" />
                    <Border Style="{StaticResource CardBorderStyle}" Padding="16,0,16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource LabelStyle}" Text="Notes" />
                            <TextBox Style="{StaticResource LinesStyle}" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="Shown in EasyVPN on the workstations: what is where, who to call." />

                            <TextBlock Style="{StaticResource LabelStyle}" Text="Links" />
                            <TextBox Style="{StaticResource LinesStyle}" Text="{Binding Links, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource HintStyle}" Text="One per line, as Name = address: https://… opens the browser, rdp://host Remote Desktop." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ footer -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0">
            <DockPanel Margin="24,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Close" IsCancel="True" Click="OnCloseClick" />
                    <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="Save" Command="{Binding SaveCommand}" />
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource Visible}}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Status}" Visibility="{Binding Error, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
