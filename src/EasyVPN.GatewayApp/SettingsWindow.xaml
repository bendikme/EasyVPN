<Window x:Class="EasyVPN.GatewayApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:EasyVPN"
        Title="Settings"
        Style="{StaticResource DialogWindowStyle}"
        Icon="pack://application:,,,/Assets/easyvpn.ico"
        Width="720"
        Height="600"
        MinWidth="560"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <app:VisibilityConverter x:Key="Visible" />

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Style="{StaticResource AppScrollViewerStyle}">
            <StackPanel Margin="24,18,24,24">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="What every facility of a kind shares, set here once. A facility's own setting, or its own password, wins over these." />
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,6" Text="{Binding Heading}" />
                            <Border Style="{StaticResource CardBorderStyle}" Padding="16,2,16,14">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Field.Label}" />
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right"
                                                                Margin="8,0,0,0"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Content="Browse…"
                                                                Command="{Binding DataContext.BrowseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding CanBrowse, Converter={StaticResource Visible}}" />
                                                        <TextBox Style="{StaticResource AppTextBoxStyle}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource HintTextStyle}" Text="{Binding Field.SharedHint}" Visibility="{Binding Field.SharedHint, Converter={StaticResource Visible}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Visibility="{Binding Kind.SharesPassword, Converter={StaticResource Visible}}">
                                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Password" />
                                        <PasswordBox Style="{StaticResource AppPasswordBoxStyle}" PasswordChanged="OnPasswordChanged" />
                                        <DockPanel Margin="0,4,0,0">
                                            <Button DockPanel.Dock="Right"
                                                    Style="{StaticResource SubtleButtonStyle}"
                                                    Content="Remove it"
                                                    Click="OnRemovePasswordClick"
                                                    Visibility="{Binding CanRemovePassword, Converter={StaticResource Visible}}" />
                                            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0" VerticalAlignment="Center" Text="{Binding PasswordText}" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource DialogFooterStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Close" IsCancel="True" Click="OnCloseClick" />
                    <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}" Content="Save" Command="{Binding SaveCommand}" />
                </StackPanel>
                <Grid VerticalAlignment="Center">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Text="{Binding Error}" Visibility="{Binding Error, Converter={StaticResource Visible}}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Status}" Visibility="{Binding Error, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
