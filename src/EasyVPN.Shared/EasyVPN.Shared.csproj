<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the gateway, the agent and the apps all speak: the API contracts, and the helpers the
       two services share: the tunnel (Wintun, the packet link) and running PowerShell. -->
  <PropertyGroup>
    <RootNamespace>EasyVPN</RootNamespace>
    <!-- Wintun hands packets over in its own memory: copied there and back, with no copy between. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Sets up the Layer 2 adapter; beside the exe of every project that uses this one. -->
  <ItemGroup>
    <None Update="layer2.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
