<Window x:Class="EasyVPN.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Style="{StaticResource DialogWindowStyle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel>
        <StackPanel Margin="24,18,24,22">
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="GATEWAY" />
            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0"
                       Text="The machine that runs the customers' VPN clients. Its EasyVPN Gateway app shows these under Workstations." />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Address" />
            <TextBox x:Name="GatewayBox" Style="{StaticResource AppTextBoxStyle}" />
            <TextBlock Style="{StaticResource HintTextStyle}" Text="A name or IP address, with :port when it is not 8420." />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Access key" />
            <PasswordBox x:Name="KeyBox" Style="{StaticResource AppPasswordBoxStyle}" />
            <TextBlock x:Name="KeyHint" Style="{StaticResource HintTextStyle}" Text="Leave it empty to keep the key already saved." Visibility="Collapsed" />

            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Certificate" />
            <DockPanel>
                <Button x:Name="ForgetButton"
                        DockPanel.Dock="Right"
                        Margin="12,0,0,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource SubtleButtonStyle}"
                        Content="Forget"
                        ToolTip="Pin whichever certificate the gateway shows next - after it was reinstalled, say"
                        Click="OnForgetClick" />
                <TextBlock x:Name="ThumbprintText"
                           Style="{StaticResource MonoTextStyle}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
            <TextBlock Style="{StaticResource HintTextStyle}"
                       Text="Pinned the first time this PC reaches the gateway, and the only one accepted after that. It should match the gateway app's." />

            <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0,24,0,10" Text="THIS PC" />
            <CheckBox x:Name="StartWithWindowsBox"
                      Style="{StaticResource AppCheckBoxStyle}"
                      Content="Start EasyVPN in the notification area when I sign in" />
            <CheckBox x:Name="NotificationsBox"
                      Margin="0,10,0,0"
                      Style="{StaticResource AppCheckBoxStyle}"
                      Content="Notify me when the connection changes" />
            <TextBlock Style="{StaticResource HintTextStyle}"
                       Text="Connected, interrupted, failed, or disconnected by someone else - not what you did yourself." />
        </StackPanel>

        <Border Style="{StaticResource DialogFooterStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" IsCancel="True" />
                    <Button x:Name="SaveButton"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0"
                            Content="Save"
                            IsDefault="True"
                            Click="OnSaveClick" />
                </StackPanel>
                <TextBlock x:Name="ErrorText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}"
                           Visibility="Collapsed" />
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
