<Window x:Class="EasyVPN.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyVPN settings"
        Style="{StaticResource AppWindowStyle}"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24,20,24,22">
        <TextBlock Text="Gateway" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource HintStyle}"
                   Text="The machine that runs the customers' VPN clients. On it, the EasyVPN Gateway app shows all three of these." />

        <TextBlock Style="{StaticResource LabelStyle}" Text="Address" />
        <TextBox x:Name="GatewayBox" Style="{StaticResource AppTextBoxStyle}" />
        <TextBlock Style="{StaticResource HintStyle}" Text="A name or IP address, with :port when it is not 8420." />

        <TextBlock Style="{StaticResource LabelStyle}" Text="Access key" />
        <PasswordBox x:Name="KeyBox" Style="{StaticResource AppPasswordBoxStyle}" />
        <TextBlock x:Name="KeyHint" Style="{StaticResource HintStyle}" Text="Leave it empty to keep the key already saved." Visibility="Collapsed" />

        <TextBlock Style="{StaticResource LabelStyle}" Text="Gateway certificate" />
        <DockPanel>
            <Button x:Name="ForgetButton"
                    DockPanel.Dock="Right"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Content="Forget"
                    ToolTip="Pin whichever certificate the gateway shows next - after it was reinstalled, say"
                    Click="OnForgetClick" />
            <TextBlock x:Name="ThumbprintText"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       FontFamily="Consolas"
                       FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </DockPanel>
        <TextBlock Style="{StaticResource HintStyle}"
                   Text="Pinned the first time this PC reaches the gateway, and the only one accepted after that. It should match what the EasyVPN Gateway app shows." />

        <Border Style="{StaticResource AppSeparatorStyle}" Margin="0,20,0,16" />

        <CheckBox x:Name="StartWithWindowsBox"
                  Style="{StaticResource AppCheckBoxStyle}"
                  Content="Start EasyVPN in the notification area when I sign in" />

        <CheckBox x:Name="NotificationsBox"
                  Margin="0,10,0,0"
                  Style="{StaticResource AppCheckBoxStyle}"
                  Content="Notify me when the connection changes" />
        <TextBlock Style="{StaticResource HintStyle}"
                   Text="Connected, interrupted, failed, or disconnected by someone else - not what you did yourself." />

        <TextBlock x:Name="ErrorText"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource DangerBrush}"
                   Visibility="Collapsed" />

        <StackPanel Margin="0,22,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" IsCancel="True" />
            <Button x:Name="SaveButton"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="8,0,0,0"
                    Content="Save"
                    IsDefault="True"
                    Click="OnSaveClick" />
        </StackPanel>
    </StackPanel>
</Window>
