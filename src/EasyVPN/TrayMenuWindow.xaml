<Window x:Class="EasyVPN.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:local="clr-namespace:EasyVPN"
        xmlns:easy="clr-namespace:EasyVPN;assembly=EasyVPN.Shared"
        mc:Ignorable="po"
        Title="EasyVPN"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        Width="420"
        Height="520"
        MinHeight="120"
        MaxHeight="620"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="{StaticResource FontSizeNormal}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- DynatecRDM's quick launch, for facilities: the same window, rows and keys. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Rows.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:VisibilityConverter x:Key="Visible" />

            <Style x:Key="TrayGlyph" TargetType="Path">
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="Width" Value="15" />
                <Setter Property="Height" Value="15" />
                <Setter Property="StrokeThickness" Value="1.7" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="TrayFooterGlyph" TargetType="Path" BasedOn="{StaticResource TrayGlyph}">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- The one-click way out of the connection, and the only way a click connects a facility:
                 the row buttons both apps share. Not focusable, so the search box stays in charge of the
                 keys (Delete and Enter do the same for the row chosen). -->
            <Style x:Key="TrayDisconnectButton" TargetType="Button" BasedOn="{StaticResource RowDangerButtonStyle}">
                <Setter Property="Content" Value="Disconnect" />
                <Setter Property="Command" Value="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            </Style>
            <Style x:Key="TrayConnectButton" TargetType="Button" BasedOn="{StaticResource RowActionButtonStyle}">
                <Setter Property="Content" Value="Connect" />
                <Setter Property="Command" Value="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                <Setter Property="CommandParameter" Value="{Binding}" />
            </Style>

            <!-- Rows: no inner padding                 a group's opens or closes it, and the one connected shows it in the window. -->
            <Style x:Key="TrayRowContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource RowContainerStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="IsTabStop" Value="False" />
                <EventSetter Event="MouseLeftButtonUp" Handler="OnRowMouseLeftButtonUp" />
            </Style>

            <Style x:Key="TrayFooterButton" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
                <Setter Property="Padding" Value="6,5" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            </Style>

            <!-- The facility connected: its state, what it is doing, and Disconnect. -->
            <DataTemplate DataType="{x:Type local:ConnectedRow}">
                <Grid Margin="10,6,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Facility.Name}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Margin="0,0,6,0" Style="{StaticResource StatusDotStyle}" Tag="{Binding Facility.State}" />
                            <TextBlock VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding StateText}" />
                            <TextBlock Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Facility.GroupPath}" />
                        </StackPanel>
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"
                                   MaxHeight="34"
                                   Text="{Binding Message}"
                                   Visibility="{Binding Message, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Style="{StaticResource TrayDisconnectButton}"
                            ToolTip="Ends the connection: the gateway disconnects the facility's VPN"
                            Visibility="{Binding CanDisconnect, Converter={StaticResource Visible}}" />
                </Grid>
            </DataTemplate>

            <!-- A facility: its colour bar, name, group and kind; a star, a dot when it is the one;
                 and, under the mouse or chosen, its Connect button. -->
            <DataTemplate DataType="{x:Type local:FacilityRow}">
                <Grid Margin="8,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="3"
                            MinHeight="24"
                            CornerRadius="2"
                            Margin="{Binding Indent}"
                            Background="{DynamicResource BorderBrushSoft}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock TextTrimming="CharacterEllipsis" Text="{Binding Facility.Name}" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Facility.Summary}" />
                    </StackPanel>
                    <Path Grid.Column="2"
                          Width="11"
                          Height="11"
                          Margin="8,0,0,0"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Data="{StaticResource GeoStar}"
                          Fill="{DynamicResource WarningBrush}"
                          Visibility="{Binding Facility.IsFavourite, Converter={StaticResource Visible}}" />
                    <Ellipse Grid.Column="3"
                             Margin="8,0,0,0"
                             Style="{StaticResource StatusDotStyle}"
                             Tag="{Binding Facility.State}"
                             Visibility="{Binding Facility.IsActive, Converter={StaticResource Visible}}" />
                    <Button x:Name="ConnectButton"
                            Grid.Column="4"
                            Margin="8,0,0,0"
                            Style="{StaticResource TrayConnectButton}"
                            Visibility="Collapsed"
                            ToolTip="Connects this facility: the gateway brings up its VPN" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="ConnectButton" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter TargetName="ConnectButton" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <!-- Up already, or on its way: nothing to connect. -->
                    <DataTrigger Binding="{Binding Facility.IsUp}" Value="True">
                        <Setter TargetName="ConnectButton" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="Root"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushStrong}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusLarge}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand strip, and the connection in a few words. -->
            <Grid Grid.Row="0" Margin="14,11,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource BrandMarkTemplate}" Focusable="False" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="EasyVPN" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Summary}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static easy:CheckLevel.Ok}">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static easy:CheckLevel.Warning}">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static easy:CheckLevel.Problem}">
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Search -->
            <Grid Grid.Row="1" Margin="12,8,12,6">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource AppTextBoxStyle}"
                         MinHeight="32"
                         Padding="30,6,10,6"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Path Margin="10,0,0,0"
                      HorizontalAlignment="Left"
                      IsHitTestVisible="False"
                      Style="{StaticResource TrayGlyph}"
                      Width="13"
                      Height="13"
                      Data="{StaticResource GeoSearch}" />
                <TextBlock Margin="32,0,10,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Search facilities, customers, groups"
                           Visibility="{Binding SearchText, Converter={StaticResource Visible}, ConverterParameter=invert}" />
            </Grid>

            <!-- Rows -->
            <ListBox x:Name="RowsList"
                     Grid.Row="2"
                     Style="{StaticResource AppListBoxStyle}"
                     ItemContainerStyle="{StaticResource TrayRowContainerStyle}"
                     ItemsSource="{Binding Rows}"
                     SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                     Focusable="False"
                     Padding="4,0,4,4"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" />

            <!-- Footer -->
            <Border Grid.Row="3"
                    Padding="6"
                    Background="{DynamicResource SurfaceAltBrush}"
                    BorderBrush="{DynamicResource BorderBrushSoft}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,9,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource TrayFooterButton}" Click="OnOpenClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TrayFooterGlyph}" Data="{StaticResource GeoWindow}" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Open EasyVPN" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource TrayFooterButton}" Click="OnSettingsClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TrayFooterGlyph}" Data="{StaticResource GeoGear}" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Settings" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource TrayFooterButton}" Click="OnExitClick">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource TrayFooterGlyph}" Data="{StaticResource GeoExit}" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Exit" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
