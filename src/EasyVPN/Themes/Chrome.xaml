<!-- The window frame both apps share: no Windows title bar, a strip of their own instead with the
     brand mark, toolbar buttons and window buttons drawn like Windows' - and the icons in it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Icons: 24 x 24 path data, stroked, scaled by a Viewbox. -->
    <PathGeometry x:Key="GeoSearch" Figures="M4,10.5 A6.5,6.5 0 1 1 17,10.5 A6.5,6.5 0 1 1 4,10.5 Z M15.4,15.4 L20,20" />
    <PathGeometry x:Key="GeoClose" Figures="M6,6 L18,18 M18,6 L6,18" />
    <PathGeometry x:Key="GeoRefresh" Figures="M19.5,12 A7.5,7.5 0 1 1 16.82,6.26 M16.51,2.67 L16.82,6.26 L13.23,6.57" />
    <PathGeometry x:Key="GeoGear"
                  Figures="M10.43,5.18 L10.63,2.80 L13.37,2.80 L13.57,5.18 A7.0,7.0 0 0 1 15.71,6.06 L17.53,4.52 L19.48,6.47 L17.94,8.29 A7.0,7.0 0 0 1 18.82,10.43 L21.20,10.63 L21.20,13.37 L18.82,13.57 A7.0,7.0 0 0 1 17.94,15.71 L19.48,17.53 L17.53,19.48 L15.71,17.94 A7.0,7.0 0 0 1 13.57,18.82 L13.37,21.20 L10.63,21.20 L10.43,18.82 A7.0,7.0 0 0 1 8.29,17.94 L6.47,19.48 L4.52,17.53 L6.06,15.71 A7.0,7.0 0 0 1 5.18,13.57 L2.80,13.37 L2.80,10.63 L5.18,10.43 A7.0,7.0 0 0 1 6.06,8.29 L4.52,6.47 L6.47,4.52 L8.29,6.06 A7.0,7.0 0 0 1 10.43,5.18 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z" />
    <PathGeometry x:Key="GeoStar"
                  Figures="M12,3.4 L14.6,9.2 L20.9,9.9 L16.2,14.1 L17.5,20.3 L12,17.1 L6.5,20.3 L7.8,14.1 L3.1,9.9 L9.4,9.2 Z" />
    <PathGeometry x:Key="GeoEdit" Figures="M4.5,19.5 L4.5,16 L15.5,5 L19,8.5 L8,19.5 Z M13.5,7 L17,10.5" />
    <PathGeometry x:Key="GeoImport" Figures="M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5 M4.5,15.5 L4.5,19.5 L19.5,19.5 L19.5,15.5" />
    <!-- The brand mark, drawn the same in Assets\easyvpn.ico: a shield with a keyhole. -->
    <PathGeometry x:Key="GeoShield" Figures="M12,2.6 L19.4,5.5 L19.4,11.2 C19.4,15.9 16.3,19.5 12,21.2 C7.7,19.5 4.6,15.9 4.6,11.2 L4.6,5.5 Z" />
    <PathGeometry x:Key="GeoKeyhole" Figures="M10,10.2 A2,2 0 1 1 14,10.2 A2,2 0 0 1 12.9,12 L13.3,15.8 L10.7,15.8 L11.1,12 A2,2 0 0 1 10,10.2 Z" />

    <!-- Pins a 24-unit icon's frame, so every icon is centred and scaled alike in its Viewbox. -->
    <Style x:Key="IconFrameStyle" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="-2" />
    </Style>

    <Style x:Key="ToolbarIconStyle" TargetType="Path" BasedOn="{StaticResource IconFrameStyle}">
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- The brand mark in a rounded tile, as at the left of the title strip:
         <ContentControl Template="{StaticResource BrandMarkTemplate}" Focusable="False" /> -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="ContentControl">
        <Border Width="24" Height="24" CornerRadius="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#FF2A94FF" />
                    <GradientStop Offset="1" Color="#FF004CCC" />
                </LinearGradientBrush>
            </Border.Background>
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource GeoShield}" Fill="White" />
                    <Path Data="{StaticResource GeoKeyhole}" Fill="#FF0058D6" />
                </Canvas>
            </Viewbox>
        </Border>
    </ControlTemplate>

    <!-- Window buttons drawn like the Windows ones: 46 wide, full height, the system glyph font. -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionMaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Content" Value="&#xE922;" />
        <Setter Property="ToolTip" Value="Maximise" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Content" Value="&#xE923;" />
                <Setter Property="ToolTip" Value="Restore" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#B0271A" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- The status strip at the foot of the window: small text, muted. -->
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

</ResourceDictionary>
