<!-- The window frame both apps share: no Windows title bar, a strip of their own instead with the
     brand mark, toolbar buttons and window buttons drawn like Windows' - and the icons in it. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Controls.xaml (which merges Theme.xaml) for the window and button styles the dialog frame
         builds on. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The title strip's row: 44 for what is in it - the brand mark, buttons, the search box, all
         of even height, so each sits exactly in the middle - and the 1px line under it. -->
    <GridLength x:Key="TitleStripHeight">45</GridLength>

    <!-- Icons: 24 x 24 path data, stroked, scaled by a Viewbox. -->
    <PathGeometry x:Key="GeoSearch" Figures="M4,10.5 A6.5,6.5 0 1 1 17,10.5 A6.5,6.5 0 1 1 4,10.5 Z M15.4,15.4 L20,20" />
    <PathGeometry x:Key="GeoClose" Figures="M6,6 L18,18 M18,6 L6,18" />
    <PathGeometry x:Key="GeoRefresh" Figures="M19.5,12 A7.5,7.5 0 1 1 16.82,6.26 M16.51,2.67 L16.82,6.26 L13.23,6.57" />
    <PathGeometry x:Key="GeoGear"
                  Figures="M10.43,5.18 L10.63,2.80 L13.37,2.80 L13.57,5.18 A7.0,7.0 0 0 1 15.71,6.06 L17.53,4.52 L19.48,6.47 L17.94,8.29 A7.0,7.0 0 0 1 18.82,10.43 L21.20,10.63 L21.20,13.37 L18.82,13.57 A7.0,7.0 0 0 1 17.94,15.71 L19.48,17.53 L17.53,19.48 L15.71,17.94 A7.0,7.0 0 0 1 13.57,18.82 L13.37,21.20 L10.63,21.20 L10.43,18.82 A7.0,7.0 0 0 1 8.29,17.94 L6.47,19.48 L4.52,17.53 L6.06,15.71 A7.0,7.0 0 0 1 5.18,13.57 L2.80,13.37 L2.80,10.63 L5.18,10.43 A7.0,7.0 0 0 1 6.06,8.29 L4.52,6.47 L6.47,4.52 L8.29,6.06 A7.0,7.0 0 0 1 10.43,5.18 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z" />
    <PathGeometry x:Key="GeoStar"
                  Figures="M12,3.4 L14.6,9.2 L20.9,9.9 L16.2,14.1 L17.5,20.3 L12,17.1 L6.5,20.3 L7.8,14.1 L3.1,9.9 L9.4,9.2 Z" />
    <PathGeometry x:Key="GeoEdit" Figures="M4.5,19.25 L4.5,15.75 L15.5,4.75 L19,8.25 L8,19.25 Z M13.5,6.75 L17,10.25" />
    <PathGeometry x:Key="GeoImport" Figures="M12,4.25 L12,15.25 M7.5,10.75 L12,15.25 L16.5,10.75 M4.5,15.75 L4.5,19.75 L19.5,19.75 L19.5,15.75" />
    <PathGeometry x:Key="GeoExport" Figures="M12,15.25 L12,4.25 M7.5,8.75 L12,4.25 L16.5,8.75 M4.5,15.75 L4.5,19.75 L19.5,19.75 L19.5,15.75" />
    <PathGeometry x:Key="GeoWorkstation" Figures="M3.5,4.5 L20.5,4.5 L20.5,15.5 L3.5,15.5 Z M9,19.5 L15,19.5 M12,15.5 L12,19.5" />
    <PathGeometry x:Key="GeoMore" Figures="M5,12 A1,1 0 1 1 7,12 A1,1 0 1 1 5,12 Z M11,12 A1,1 0 1 1 13,12 A1,1 0 1 1 11,12 Z M17,12 A1,1 0 1 1 19,12 A1,1 0 1 1 17,12 Z" />
    <PathGeometry x:Key="GeoChevronDown" Figures="M6,9.5 L12,15.5 L18,9.5" />
    <PathGeometry x:Key="GeoChevron" Figures="M9.5,6 L15.5,12 L9.5,18" />
    <PathGeometry x:Key="GeoWindow" Figures="M3,5 L21,5 L21,19 L3,19 Z M3,9 L21,9" />
    <PathGeometry x:Key="GeoExit" Figures="M14,4 L19.5,4 L19.5,20 L14,20 M10,8 L6,12 L10,16 M6,12 L15,12" />
    <PathGeometry x:Key="GeoPlus" Figures="M12,5 L12,19 M5,12 L19,12" />
    <!-- The brand mark, drawn the same in Assets\easyvpn.ico: a shield with a keyhole. -->
    <PathGeometry x:Key="GeoShield" Figures="M12,2.6 L19.4,5.5 L19.4,11.2 C19.4,15.9 16.3,19.5 12,21.2 C7.7,19.5 4.6,15.9 4.6,11.2 L4.6,5.5 Z" />
    <PathGeometry x:Key="GeoKeyhole" Figures="M10,10.2 A2,2 0 1 1 14,10.2 A2,2 0 0 1 12.9,12 L13.3,15.8 L10.7,15.8 L11.1,12 A2,2 0 0 1 10,10.2 Z" />

    <!-- Pins a 24-unit icon's frame, so every icon is centred and scaled alike in its Viewbox. -->
    <Style x:Key="IconFrameStyle" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="-2" />
    </Style>

    <Style x:Key="ToolbarIconStyle" TargetType="Path" BasedOn="{StaticResource IconFrameStyle}">
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- The brand mark in a rounded tile, as at the left of the title strip:
         <ContentControl Template="{StaticResource BrandMarkTemplate}" Focusable="False" /> -->
    <ControlTemplate x:Key="BrandMarkTemplate" TargetType="ContentControl">
        <Border Width="24" Height="24" CornerRadius="5">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#FF2A94FF" />
                    <GradientStop Offset="1" Color="#FF004CCC" />
                </LinearGradientBrush>
            </Border.Background>
            <Viewbox Width="18" Height="18">
                <Canvas Width="24" Height="24">
                    <Path Data="{StaticResource GeoShield}" Fill="White" />
                    <Path Data="{StaticResource GeoKeyhole}" Fill="#FF0058D6" />
                </Canvas>
            </Viewbox>
        </Border>
    </ControlTemplate>

    <!-- Window buttons drawn like the Windows ones: 46 wide, full height, the system glyph font. -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionMaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Content" Value="&#xE922;" />
        <Setter Property="ToolTip" Value="Maximise" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Content" Value="&#xE923;" />
                <Setter Property="ToolTip" Value="Restore" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#B0271A" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A dialog: the main windows' frame, smaller - a strip with the brand mark, the window's title
         and its close button over the content - and a footer bar for its buttons, the forward one
         (Primary) rightmost. The window calls WindowFrame.Dialog(this) for its close button. -->
    <Style x:Key="DialogWindowStyle" TargetType="Window" BasedOn="{StaticResource AppWindowStyle}">
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="44"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0,0,0,1"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border Background="{TemplateBinding Background}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{StaticResource TitleStripHeight}" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
                                <DockPanel Margin="14,0,0,0">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource CaptionCloseButtonStyle}"
                                            Content="&#xE8BB;"
                                            ToolTip="Close"
                                            WindowChrome.IsHitTestVisibleInChrome="True"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}" />
                                    <ContentControl VerticalAlignment="Center" Template="{StaticResource BrandMarkTemplate}" Focusable="False" />
                                    <TextBlock Margin="9,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="{StaticResource FontSizeMedium}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{TemplateBinding Title}" />
                                </DockPanel>
                            </Border>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DialogFooterStyle" TargetType="Border">
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- The status strip at the foot of the window: small text, muted. Left, the connection, then
         what it goes through (the service, the gateway); right, updates and the version. Its one
         action is the update link: fixes belong in the window. -->
    <Style x:Key="StatusStripStyle" TargetType="Border">
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style x:Key="StatusSeparatorStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
        <Setter Property="Margin" Value="10,0" />
        <Setter Property="Text" Value="·" />
    </Style>

    <!-- The activity panel's header: a thin bar with its title left and its buttons right. -->
    <Style x:Key="PanelHeaderStyle" TargetType="Border">
        <Setter Property="Padding" Value="24,0,16,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushSoft}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

</ResourceDictionary>
