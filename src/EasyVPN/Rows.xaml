<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:local="clr-namespace:EasyVPN">

    <!-- What the window's list and the tray menu share: a group, which opens and closes, and the
         lines that are not rows (titles, messages). Their facility rows are each their own. The
         list's view model has a ToggleGroupCommand. A group's button and chevron are the themes',
         which the gateway app's groups use too. -->

    <local:VisibilityConverter x:Key="RowVisible" />

    <DataTemplate DataType="{x:Type local:GroupRow}">
        <Button Margin="{Binding Indent}"
                Style="{StaticResource GroupRowButtonStyle}"
                Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                CommandParameter="{Binding}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="{Binding Count}" />
                <!-- The facility connected is in here, closed. -->
                <Ellipse DockPanel.Dock="Right"
                         Width="7"
                         Height="7"
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource SuccessBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasActive}" Value="True" />
                                        <Condition Binding="{Binding IsOpen}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Path x:Name="Chevron"
                      Width="10"
                      Height="10"
                      Margin="0,0,7,0"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Data="{StaticResource GeoChevron}"
                      Stroke="{DynamicResource TextMutedBrush}"
                      StrokeThickness="1.8"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      RenderTransformOrigin="0.5,0.5" />
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           Text="{Binding Name}" />
            </DockPanel>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsOpen}" Value="True">
                <Setter TargetName="Chevron" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="90" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:SectionRow}">
        <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="10,11,10,3" Text="{Binding Title}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type local:MessageRow}">
        <TextBlock Margin="14,14"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextMutedBrush}"
                   Text="{Binding Text}" />
    </DataTemplate>

    <!-- Containers: a group's row is its own button, and titles and messages are no rows at all;
         neither is ever the list's selection. -->
    <Style x:Key="RowContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItemStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                <Setter Property="IsEnabled" Value="False" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
