<Window x:Class="EasyVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyVPN"
        Title="EasyVPN"
        Style="{StaticResource AppWindowStyle}"
        Icon="pack://application:,,,/Assets/easyvpn.ico"
        Width="1100"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <!-- As in DynatecRDM: no Windows title bar; the header strip is the caption, with the window
         buttons at its right edge. The one-pixel glass edge keeps the Windows shadow and corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Rows.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <local:VisibilityConverter x:Key="Visible" />

        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FactLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,18,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="FactValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <!-- In place of the facility: a title, a sentence, and the one thing to do about it. -->
        <Style x:Key="EmptyTitleStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="EmptyTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="{StaticResource TitleStripHeight}" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             Title strip: brand, search, toolbar, window buttons. It is the
             window's caption too, so everything clickable in it opts back in
             to the mouse.
             ============================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100*" MaxWidth="480" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Template="{StaticResource BrandMarkTemplate}" Focusable="False" />
                    <TextBlock Text="EasyVPN"
                               Margin="9,0,0,0"
                               FontSize="{StaticResource FontSizeMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="24,0,16,0"
                      VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource AppTextBoxStyle}"
                             Padding="32,5,30,5"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search facilities by name, customer, network or notes (Ctrl+F)" />
                    <Viewbox Width="14"
                             Height="14"
                             Margin="10,0,0,0"
                             HorizontalAlignment="Left"
                             IsHitTestVisible="False">
                        <Path Style="{StaticResource IconFrameStyle}"
                              Data="{StaticResource GeoSearch}"
                              StrokeThickness="1.7"
                              StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextMutedBrush}" />
                    </Viewbox>
                    <TextBlock Text="Search facilities"
                               Margin="34,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                    <Button Width="22"
                            Height="22"
                            MinHeight="0"
                            Margin="0,0,4,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="Clear the search"
                            Visibility="{Binding SearchText, Converter={StaticResource Visible}}">
                        <Viewbox Width="10" Height="10">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoClose}" />
                        </Viewbox>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="3"
                            Margin="0,0,8,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Fetch the facilities from the gateway again">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoRefresh}" />
                            </Viewbox>
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Margin="4,0,0,0"
                            Click="OnSettingsClick"
                            ToolTip="The gateway this PC uses, and starting with Windows">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoGear}" />
                            </Viewbox>
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimise" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionMaximizeButtonStyle}" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;" ToolTip="Close to the notification area" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ banners: what went wrong in the app -->
        <Border Grid.Row="1" Style="{StaticResource BannerStyle}" Visibility="{Binding Error, Converter={StaticResource Visible}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>

        <!-- ============================================================
             Body: facilities on the left, the selected one on the right
             ============================================================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                    <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="Filter" Content="All" IsChecked="{Binding ShowAll}" />
                    <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="Filter" Content="Favourites" IsChecked="{Binding FavouritesOnly}" />
                </StackPanel>

                <!-- Groups, which open and close, and the facilities in those open. -->
                <ListBox Grid.Row="1"
                         Margin="6,0,4,6"
                         Style="{StaticResource AppListBoxStyle}"
                         ItemContainerStyle="{StaticResource RowContainerStyle}"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow}"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.Resources>
                        <DataTemplate DataType="{x:Type local:FacilityRow}">
                            <!-- Double-click connects, as it launches a session in DynatecRDM. -->
                            <Grid Margin="{Binding Indent}" Background="Transparent" AutomationProperties.Name="{Binding Facility.Name}">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding Facility}" />
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="17,0,0,0">
                                    <TextBlock Text="{Binding Facility.Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Facility.Summary}"
                                               Margin="0,1,0,0"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Viewbox Grid.Column="1"
                                         Width="11"
                                         Height="11"
                                         Margin="8,0,0,0"
                                         Visibility="{Binding Facility.IsFavourite, Converter={StaticResource Visible}}">
                                    <Path Style="{StaticResource IconFrameStyle}" Data="{StaticResource GeoStar}" Fill="{DynamicResource WarningBrush}" />
                                </Viewbox>
                                <Ellipse Grid.Column="2"
                                         Margin="8,0,2,0"
                                         Style="{StaticResource StatusDotStyle}"
                                         Tag="{Binding Facility.State}"
                                         Visibility="{Binding Facility.IsActive, Converter={StaticResource Visible}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Margin="20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="Nothing matches the search."
                           Visibility="{Binding NoMatches, Converter={StaticResource Visible}}" />

                <TextBlock Grid.Row="1"
                           Margin="20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="The gateway has no facilities yet. They are added in the EasyVPN Gateway app, on the gateway."
                           Visibility="{Binding HasNoFacilities, Converter={StaticResource Visible}}" />
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrushSoft}" />

            <!-- The selected facility: its header stays, its details scroll. -->
            <Grid Grid.Column="2" Visibility="{Binding ShowFacility, Converter={StaticResource Visible}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,20,24,16" MaxWidth="820" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding Selected.Customer}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Selected.Name}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <!-- A favourite's star, filled; any other's, outlined: a click turns it over. -->
                        <Button Margin="8,2,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}"
                                Command="{Binding ToggleFavouriteCommand}"
                                ToolTip="{Binding FavouriteText}">
                            <Viewbox Width="16" Height="16">
                                <Path Data="{StaticResource GeoStar}" StrokeThickness="1.6" StrokeLineJoin="Round">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource IconFrameStyle}">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Selected.IsFavourite}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                    <Setter Property="Stroke" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Viewbox>
                        </Button>
                        <Ellipse Margin="14,2,7,0" Style="{StaticResource StatusDotStyle}" Tag="{Binding SelectedState}" Visibility="{Binding ShowSelectedState, Converter={StaticResource Visible}}" />
                        <TextBlock Margin="0,2,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding SelectedStateText}"
                                   Visibility="{Binding ShowSelectedState, Converter={StaticResource Visible}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding SelectedMessage}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding SelectedMessage, Converter={StaticResource Visible}}" />

                    <!-- Connecting is the one thing done most; while connected, the same place ends it.
                         What the facility offers to open sits beside it. -->
                    <WrapPanel Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="120"
                                Margin="0,0,8,8"
                                Content="Connect"
                                Command="{Binding ConnectCommand}"
                                Visibility="{Binding CanConnect, Converter={StaticResource Visible}}" />
                        <Button Style="{StaticResource DangerButtonStyle}"
                                MinWidth="120"
                                Margin="0,0,8,8"
                                Content="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                Visibility="{Binding CanDisconnect, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Selected.Links}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            Content="{Binding Name}"
                                            ToolTip="{Binding Url}"
                                            Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Style="{StaticResource AppScrollViewerStyle}" Padding="24,0,24,20">
                    <Border MaxWidth="820" HorizontalAlignment="Stretch" Style="{StaticResource CardBorderStyle}" Padding="16,14,16,6" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Style="{StaticResource FactLabelStyle}" Text="Networks" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Routes}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource FactLabelStyle}" Text="Adapter" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Link}" />

                            <TextBlock Grid.Row="2" Style="{StaticResource FactLabelStyle}" Text="DNS" Visibility="{Binding Selected.Dns, Converter={StaticResource Visible}}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Dns}" Visibility="{Binding Selected.Dns, Converter={StaticResource Visible}}" />

                            <TextBlock Grid.Row="3" Style="{StaticResource FactLabelStyle}" Text="Check" Visibility="{Binding Selected.Check, Converter={StaticResource Visible}}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Check}" Visibility="{Binding Selected.Check, Converter={StaticResource Visible}}" />

                            <TextBlock Grid.Row="4" Style="{StaticResource FactLabelStyle}" Text="VPN client" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Info.Connector}" />

                            <TextBlock Grid.Row="5" Style="{StaticResource FactLabelStyle}" Text="Notes" Visibility="{Binding Selected.Notes, Converter={StaticResource Visible}}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Notes}" Visibility="{Binding Selected.Notes, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- In place of the facility: the agent missing, or no gateway chosen yet. -->
            <StackPanel Grid.Column="2" MaxWidth="440" Margin="24" VerticalAlignment="Center"
                        Visibility="{Binding AgentOnline, Converter={StaticResource Visible}, ConverterParameter=invert}">
                <TextBlock Style="{StaticResource EmptyTitleStyle}" Text="The EasyVPN Agent is not running" />
                <TextBlock Style="{StaticResource EmptyTextStyle}"
                           Text="The agent is the Windows service that keeps the EasyVPN adapter, routes and DNS rules on this PC. Start the &quot;EasyVPN Agent&quot; service, or install EasyVPN again." />
            </StackPanel>
            <StackPanel Grid.Column="2" MaxWidth="440" Margin="24" VerticalAlignment="Center"
                        Visibility="{Binding ShowSetup, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource EmptyTitleStyle}" Text="Connect this PC to a gateway" />
                <TextBlock Style="{StaticResource EmptyTextStyle}"
                           Text="The gateway is the machine that runs the customers' VPN clients. Its EasyVPN Gateway app gives its address and access key, under Workstations." />
                <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" Content="Open settings" Click="OnSettingsClick" />
            </StackPanel>
        </Grid>

        <!-- ============================================================
             Activity: what this PC and the gateway did lately, newest
             first - the place to look when a connection fails. Folds away.
             ============================================================ -->
        <StackPanel Grid.Row="3" Background="{DynamicResource SurfaceBrush}">
            <Border Style="{StaticResource PanelHeaderStyle}">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ChevronToggleStyle}" IsChecked="{Binding ShowActivity}" ToolTip="Shows or hides the activity" />
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="0" VerticalAlignment="Center" Text="ACTIVITY" />
                </DockPanel>
            </Border>
            <ScrollViewer Height="150" Style="{StaticResource AppScrollViewerStyle}" Padding="24,0,16,8" Visibility="{Binding ShowActivity, Converter={StaticResource Visible}}">
                <Grid>
                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="{StaticResource FontSizeSmall}" Text="Nothing yet."
                               Visibility="{Binding HasActivity, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Log}"
                                  TextElement.FontSize="{StaticResource FontSizeSmall}"
                                  TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Time.LocalDateTime, StringFormat=HH:mm:ss}" />
                                    <TextBlock Grid.Column="1" Foreground="{DynamicResource TextMutedBrush}" Text="{Binding Source}" />
                                    <TextBlock Grid.Column="2" TextWrapping="Wrap" Text="{Binding Text}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </StackPanel>

        <!-- ============================================================
             Status strip: the connection, the gateway; updates
             ============================================================ -->
        <Border Grid.Row="4" Style="{StaticResource StatusStripStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0" Style="{StaticResource StatusTextStyle}" Text="{Binding UpdateNote}" Visibility="{Binding UpdateNote, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource StatusLinkButtonStyle}" Content="{Binding UpdateButtonText}" IsEnabled="{Binding CanUpdate}" Click="OnUpdateClick" />
                    <TextBlock Style="{StaticResource StatusSeparatorStyle}" Margin="4,0,10,0" Visibility="{Binding VersionText, Converter={StaticResource Visible}}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding VersionText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Margin="0,0,7,0" Style="{StaticResource StatusDotStyle}" Tag="{Binding State}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" Text="{Binding ConnectionText}" />
                    <TextBlock Style="{StaticResource StatusSeparatorStyle}" />
                    <Ellipse Margin="0,0,7,0" Style="{StaticResource StatusDotStyle}" Tag="{Binding GatewayLevel}" />
                    <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding GatewayText}" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding TunnelWarning, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource StatusSeparatorStyle}" />
                        <TextBlock Style="{StaticResource StatusTextStyle}" Foreground="{DynamicResource WarningBrush}" Text="{Binding TunnelWarning}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
