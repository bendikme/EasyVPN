<Window x:Class="EasyVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EasyVPN"
        Title="EasyVPN"
        Style="{StaticResource AppWindowStyle}"
        Icon="pack://application:,,,/Assets/easyvpn.ico"
        Width="1100"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">

    <!-- As in DynatecRDM: no Windows title bar; the header strip is the caption, with the window
         buttons at its right edge. The one-pixel glass edge keeps the Windows shadow and corners. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <local:VisibilityConverter x:Key="Visible" />

        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Cp"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FactLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,18,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
        </Style>

        <Style x:Key="FactValueStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             Title strip: brand, search, toolbar, window buttons. It is the
             window's caption too, so everything clickable in it opts back in
             to the mouse.
             ============================================================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="100*" MaxWidth="480" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#FF2A94FF" />
                                <GradientStop Offset="1" Color="#FF004CCC" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource GeoShield}" Fill="White" />
                                <Path Data="{StaticResource GeoKeyhole}" Fill="#FF0058D6" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="EasyVPN"
                               Margin="9,0,0,0"
                               FontSize="{StaticResource FontSizeMedium}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Grid Grid.Column="1"
                      Margin="24,0,16,0"
                      VerticalAlignment="Center"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource AppTextBoxStyle}"
                             Padding="32,5,30,5"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search facilities by name, customer, network or notes (Ctrl+F)" />
                    <Viewbox Width="14"
                             Height="14"
                             Margin="10,0,0,0"
                             HorizontalAlignment="Left"
                             IsHitTestVisible="False">
                        <Path Style="{StaticResource IconFrameStyle}"
                              Data="{StaticResource GeoSearch}"
                              StrokeThickness="1.7"
                              StrokeEndLineCap="Round"
                              Stroke="{DynamicResource TextMutedBrush}" />
                    </Viewbox>
                    <TextBlock Text="Search facilities"
                               Margin="34,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}"
                               IsHitTestVisible="False"
                               Visibility="{Binding SearchText, Converter={StaticResource Visible}, ConverterParameter=invert}" />
                    <Button Width="22"
                            Height="22"
                            MinHeight="0"
                            Margin="0,0,4,0"
                            Padding="0"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Center"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ClearSearchCommand}"
                            ToolTip="Clear the search"
                            Visibility="{Binding SearchText, Converter={StaticResource Visible}}">
                        <Viewbox Width="10" Height="10">
                            <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoClose}" />
                        </Viewbox>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Fetch the facilities from the gateway again">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoRefresh}" />
                            </Viewbox>
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Margin="4,0,8,0"
                            Click="OnSettingsClick"
                            ToolTip="The gateway this PC uses, and starting with Windows">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,7,0">
                                <Path Style="{StaticResource ToolbarIconStyle}" Data="{StaticResource GeoGear}" />
                            </Viewbox>
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="&#xE921;" ToolTip="Minimise" Click="OnMinimizeClick" />
                    <Button Style="{StaticResource CaptionMaximizeButtonStyle}" Click="OnMaximizeClick" />
                    <Button Style="{StaticResource CaptionCloseButtonStyle}" Content="&#xE8BB;" ToolTip="Close to the notification area" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             Body: facilities on the left, the selected one on the right
             ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,10,12,6">
                    <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="Filter" Content="All" IsChecked="{Binding ShowAll}" />
                    <RadioButton Style="{StaticResource FilterChipStyle}" GroupName="Filter" Content="Favourites" IsChecked="{Binding FavouritesOnly}" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         Margin="6,0,4,6"
                         Style="{StaticResource AppListBoxStyle}"
                         ItemsSource="{Binding View}"
                         SelectedItem="{Binding Selected}">
                    <ListBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ConnectCommand}" />
                    </ListBox.InputBindings>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource AppListBoxItemStyle}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Margin="10,12,0,4" Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:FacilityViewModel}">
                            <!-- Double-click connects, as it launches a session in DynatecRDM. -->
                            <Grid Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                  Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                </Grid.InputBindings>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Summary}"
                                               Margin="0,1,0,0"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Viewbox Grid.Column="1"
                                         Width="11"
                                         Height="11"
                                         Margin="8,0,0,0"
                                         Visibility="{Binding IsFavourite, Converter={StaticResource Visible}}">
                                    <Path Style="{StaticResource IconFrameStyle}" Data="{StaticResource GeoStar}" Fill="{DynamicResource WarningBrush}" />
                                </Viewbox>
                                <Ellipse Grid.Column="2"
                                         Width="8"
                                         Height="8"
                                         Margin="8,0,2,0"
                                         Style="{StaticResource StateDotStyle}"
                                         Tag="{Binding State}"
                                         Visibility="{Binding IsActive, Converter={StaticResource Visible}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1"
                           Margin="20"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Text="The gateway has no facilities yet. They are defined in facilities.json on the gateway."
                           Visibility="{Binding HasNoFacilities, Converter={StaticResource Visible}}" />
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrushSoft}" />

            <ScrollViewer Grid.Column="2" Style="{StaticResource AppScrollViewerStyle}" Padding="28,22,28,22">
                <StackPanel MaxWidth="820" HorizontalAlignment="Stretch">

                    <Border Margin="0,0,0,16"
                            Padding="12,8"
                            Background="{DynamicResource DangerSubtleBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusMedium}"
                            Visibility="{Binding Error, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="20"
                            Margin="0,0,0,20"
                            Visibility="{Binding AgentOnline, Converter={StaticResource Visible}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="The EasyVPN Agent is not running" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="The agent is the Windows service that keeps the EasyVPN adapter, routes and DNS rules on this PC. Start the &quot;EasyVPN Agent&quot; service, or install EasyVPN again." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}"
                            Padding="20"
                            Margin="0,0,0,20"
                            Visibility="{Binding ShowSetup, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <TextBlock Text="Connect this PC to a gateway" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,8,0,14"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="The gateway is the machine that runs the customers' VPN clients. Its administrator has its address and access key: EasyVPN.Gateway.exe info prints them." />
                            <Button Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Content="Open settings" Click="OnSettingsClick" />
                        </StackPanel>
                    </Border>

                    <!-- The selected facility -->
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Selected.Customer}" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Selected.Name}"
                                       FontSize="{StaticResource FontSizeTitle}"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                            <Viewbox Width="15"
                                     Height="15"
                                     Margin="10,0,0,0"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding Selected.IsFavourite, Converter={StaticResource Visible}}">
                                <Path Style="{StaticResource IconFrameStyle}" Data="{StaticResource GeoStar}" Fill="{DynamicResource WarningBrush}" />
                            </Viewbox>
                            <Border Style="{StaticResource StatusPillStyle}" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Style="{StaticResource StateDotStyle}" Tag="{Binding SelectedState}" />
                                    <TextBlock Text="{Binding SelectedStateText}"
                                               Margin="6,0,0,0"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Selected.Summary}"
                                   Margin="0,6,0,0"
                                   FontSize="{StaticResource FontSizeMedium}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <!-- Connecting is the one thing done most; while connected, the same place ends it. -->
                        <WrapPanel Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,0"
                                    Content="Connect"
                                    Command="{Binding ConnectCommand}"
                                    Visibility="{Binding CanConnect, Converter={StaticResource Visible}}" />
                            <Button Style="{StaticResource DangerButtonStyle}"
                                    MinWidth="120"
                                    Margin="0,0,8,0"
                                    Content="Disconnect"
                                    Command="{Binding DisconnectCommand}"
                                    Visibility="{Binding CanDisconnect, Converter={StaticResource Visible}}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Content="Open gateway desktop"
                                    ToolTip="Remote Desktop to the gateway, to sign in to a VPN client that asks"
                                    Command="{Binding OpenGatewayDesktopCommand}"
                                    Visibility="{Binding CanOpenGatewayDesktop, Converter={StaticResource Visible}}" />
                            <Button Style="{StaticResource SecondaryButtonStyle}"
                                    Content="{Binding FavouriteText}"
                                    Command="{Binding ToggleFavouriteCommand}" />
                        </WrapPanel>

                        <TextBlock Text="{Binding SelectedMessage}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding SelectedMessage, Converter={StaticResource Visible}}" />

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,20,0,0" Padding="16,14,16,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Style="{StaticResource FactLabelStyle}" Text="Link" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Link}" />

                                <TextBlock Grid.Row="1" Style="{StaticResource FactLabelStyle}" Text="Networks" Visibility="{Binding Selected.Routes, Converter={StaticResource Visible}}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Routes}" Visibility="{Binding Selected.Routes, Converter={StaticResource Visible}}" />

                                <TextBlock Grid.Row="2" Style="{StaticResource FactLabelStyle}" Text="DNS" Visibility="{Binding Selected.Dns, Converter={StaticResource Visible}}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Dns}" Visibility="{Binding Selected.Dns, Converter={StaticResource Visible}}" />

                                <TextBlock Grid.Row="3" Style="{StaticResource FactLabelStyle}" Text="Checked at" Visibility="{Binding Selected.Check, Converter={StaticResource Visible}}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Check}" Visibility="{Binding Selected.Check, Converter={StaticResource Visible}}" />

                                <TextBlock Grid.Row="4" Style="{StaticResource FactLabelStyle}" Text="VPN client" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Info.Connector}" />

                                <TextBlock Grid.Row="5" Style="{StaticResource FactLabelStyle}" Text="Notes" Visibility="{Binding Selected.Notes, Converter={StaticResource Visible}}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource FactValueStyle}" Text="{Binding Selected.Notes}" Visibility="{Binding Selected.Notes, Converter={StaticResource Visible}}" />
                            </Grid>
                        </Border>

                        <StackPanel Margin="0,20,0,0" Visibility="{Binding Selected.Links, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="OPEN" />
                            <ItemsControl ItemsSource="{Binding Selected.Links}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0,0,8,8"
                                                Content="{Binding Name}"
                                                ToolTip="{Binding Url}"
                                                Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- What this PC and the gateway did lately: the place to look when a connection fails. -->
                    <StackPanel Margin="0,20,0,0" Visibility="{Binding Log, Converter={StaticResource Visible}}">
                        <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="ACTIVITY" />
                        <Border Style="{StaticResource CardBorderStyle}" Padding="14,10">
                            <ItemsControl ItemsSource="{Binding Log}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time.LocalDateTime, StringFormat=HH:mm:ss}"
                                                       Margin="0,0,14,0"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================
             Status strip: the gateway, the tunnel and updates
             ============================================================ -->
        <Border Grid.Row="2"
                Padding="14,5"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right"
                           VerticalAlignment="Center"
                           Text="{Binding TunnelText}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{DynamicResource TextMutedBrush}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding UpdateText}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextMutedBrush}" />
                    <Button Margin="8,0,0,0"
                            Padding="6,1"
                            MinHeight="0"
                            Style="{StaticResource SubtleButtonStyle}"
                            FontSize="{StaticResource FontSizeSmall}"
                            Content="{Binding UpdateButtonText}"
                            IsEnabled="{Binding CanUpdate}"
                            Click="OnUpdateClick" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GatewayOnline}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding GatewayText}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
